# Environment variables template for Ahmed Hamada Portfolio & CMS

# --- Database ---
DATABASE_URL="file:./dev.db"
# PostgreSQL / Neon (production):
# DATABASE_URL="postgresql://neondb_owner:password@ep-xxx.neon.tech/neondb?sslmode=require"

# --- Admin Credentials ---
ADMIN_EMAIL="admin@ahmedhamada.dev"
ADMIN_PASSWORD="AdminPassword123!"
JWT_SECRET="your_secure_random_jwt_secret_here"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Image Upload (choose one) ---

# Option 1: ImgBB (free, easy) - get key from https://api.imgbb.com
IMGBB_API_KEY=""

# Option 2: Cloudinary - get credentials from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# Option 3: S3 / Cloudflare R2 / MinIO (advanced)
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_DOMAIN=""
